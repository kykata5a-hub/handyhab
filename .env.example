# Copy to .env and fill in. Never commit .env.

# Booking form submit mode: api | netlify | php
FORM_MODE=api

# Public URL of the site (canonical, hreflang, sitemap, OG image)
SITE_URL=https://example.com

# --- FORM_MODE=api: SMTP for sending booking requests ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=website@example.com
SMTP_PASS=
# Where requests are delivered
MAIL_TO=hello@example.com
MAIL_FROM="Handy Hab website <website@example.com>"

# Extra hosts the server trusts behind a proxy/tunnel (comma separated), e.g. an ngrok preview domain
TRUSTED_HOSTS=

# --- /est admin page (FORM_MODE=netlify; set both in Netlify → Site configuration → Environment variables) ---
# Password for /est, at least 8 characters
ADMIN_PASSWORD=
# Netlify personal access token (User settings → Applications) — reads form submissions
NETLIFY_API_TOKEN=
