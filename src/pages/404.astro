---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { business, telHref } from '~/config/business';
import { t } from '~/i18n';

const d = t('en');
---

<BaseLayout lang="en" title={d.meta.notFoundTitle} description={d.notFound.text} noindex>
  <section class="section">
    <div class="wrap">
      <h1 class="text-[clamp(3rem,10vw,7rem)]">{d.notFound.title}</h1>
      <p class="text-muted mt-5 max-w-prose text-lg">{d.notFound.text}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn-orange">{d.notFound.back}</a>
        <a href={telHref} class="btn btn-ghost">{business.phone.display}</a>
      </div>
    </div>
  </section>
</BaseLayout>
