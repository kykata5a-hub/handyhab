---
import { Icon } from 'astro-icon/components';

import { whatsappHref } from '~/config/business';
import { t, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---

<a
  href={whatsappHref(d.whatsapp.message)}
  target="_blank"
  rel="noopener"
  aria-label={d.whatsapp.label}
  title={d.whatsapp.label}
  class="wa-fab fixed right-4 bottom-4 z-40 grid h-16 w-16 place-items-center rounded-full bg-[#25D366] text-[#0E0E0F] shadow-[0_6px_20px_rgb(0_0_0/0.35)] ring-2 ring-[#0E0E0F]/10 transition-transform hover:scale-105 sm:right-6 sm:bottom-6"
  style="margin-bottom: env(safe-area-inset-bottom, 0px)"
>
  <Icon name="tabler:brand-whatsapp" class="h-9 w-9" aria-hidden="true" />
</a>

<style>
  /* Netlify's free plan pins a "Powered by Netlify" badge (iframe, ~50px tall) to the
     bottom-right corner; lift the button above it while the badge is on the page. */
  :global(body:has(#nl-badge-frame)) .wa-fab {
    bottom: 4.25rem;
  }
  @media (width >= 40rem) {
    :global(body:has(#nl-badge-frame)) .wa-fab {
      bottom: 5rem;
    }
  }
</style>
