---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { business, telHref } from '~/config/business';
import { localePath, t, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const p = d.privacy;
---

<BaseLayout
  lang={lang}
  title={`${d.meta.privacyTitle} — ${business.name}`}
  description={p.sections[0].p}
  page="privacy"
>
  <article class="section">
    <div class="wrap max-w-3xl">
      <h1 class="text-[clamp(2.75rem,8vw,5rem)]">{p.title}</h1>
      <p class="text-muted mt-4 text-sm">{p.updated}</p>
      {
        p.sections.map((s) => (
          <section class="border-line mt-10 border-t pt-6">
            <h2 class="text-2xl sm:text-3xl">{s.h}</h2>
            <p class="text-muted mt-3 max-w-prose">{s.p}</p>
          </section>
        ))
      }
      <p class="border-line mt-10 border-t pt-6">
        {business.name} · <a href={telHref} class="text-orange-text font-semibold hover:underline"
          >{business.phone.display}</a
        > ·
        <a href={`mailto:${business.email}`} class="text-orange-text font-semibold hover:underline">{business.email}</a>
      </p>
      <a href={localePath(lang)} class="btn btn-orange mt-10">{p.back}</a>
    </div>
  </article>
</BaseLayout>
