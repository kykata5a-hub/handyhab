---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { business, telHref, whatsappHref } from '~/config/business';
import { localePath, t, type Lang } from '~/i18n';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const p = d.terms;
---

<BaseLayout
  lang={lang}
  title={`${d.meta.termsTitle} — ${business.name}`}
  description={p.sections[0].items[0].p}
  page="terms"
>
  <article class="section">
    <div class="wrap max-w-3xl">
      <h1 class="text-[clamp(2.75rem,8vw,5rem)]">{p.title}</h1>
      <p class="text-muted mt-4 text-sm">{p.updated}</p>
      {
        p.sections.map((s) => (
          <section class="border-line mt-10 border-t pt-6">
            <h2 class="text-2xl sm:text-3xl">{s.h}</h2>
            {s.items.map((i) => (
              <>
                <p class="text-muted mt-3 max-w-prose">
                  {'b' in i && i.b && <strong class="text-ink font-semibold">{i.b} </strong>}
                  {i.p}
                </p>
                {'list' in i && i.list && (
                  <ul class="text-muted marker:text-orange mt-2 max-w-prose list-disc space-y-1.5 pl-6">
                    {i.list.map((li) => <li>{li}</li>)}
                  </ul>
                )}
              </>
            ))}
          </section>
        ))
      }
      <section class="border-line mt-10 border-t pt-6">
        <h2 class="text-2xl sm:text-3xl">{p.contact}</h2>
        <ul class="mt-3 grid gap-1.5">
          <li>{business.name}, {business.address.locality}, {business.address.region}</li>
          <li>
            {p.phoneLabel}:
            <a href={telHref} class="text-orange-text font-semibold hover:underline">{business.phone.display}</a>
            · <a href={whatsappHref()} class="text-orange-text font-semibold hover:underline" rel="noopener" target="_blank"
              >WhatsApp</a
            >
          </li>
          <li>
            {p.emailLabel}:
            <a href={`mailto:${business.email}`} class="text-orange-text font-semibold hover:underline"
              >{business.email}</a
            >
          </li>
          <li>{p.hoursLabel}: {d.footer.hoursText}</li>
        </ul>
      </section>
      <a href={localePath(lang)} class="btn btn-orange mt-10">{p.back}</a>
    </div>
  </article>
</BaseLayout>
